{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "Sophnet-deepseek": {
      "package": "aisdk:@ai-sdk/anthropic",
      "name": "Sophnet",
      "settings": {
        "baseURL": "https://www.sophnet.com/api/open-apis/anthropic",
        "apiKey": "your_API_KEY"
      },
      "models": {
        "DeepSeek-Flash": {
          "name": "DeepSeek Flash (v4.1)",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "type": "enabled"
            },
            "output_config": {
              "effort": "high"
            }
          }
        },
        "DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro (0813)",
          "limit": {
            "context": 1048576,
            "output": 262144
          },
          "settings": {
            "thinking": {
              "type": "enabled"
            },
            "output_config": {
              "effort": "max"
            }
          }
        },
        "DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash (Preview)",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "settings": {
            "thinking": {
              "type": "enabled"
            },
            "output_config": {
              "effort": "max"
            }
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "settings": {
            "output_config": {
              "effort": "max"
            }
          }
        }
      }
    }
  },
  "permissions": [
    // 文件读取权限
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // 文件编辑权限
    { "action": "edit", "resource": "*", "effect": "ask" },

    // 命令执行权限
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf", "effect": "deny" }
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".next/**",
      "build/**",
      "target/**",
      "*.log"
    ]
  },
  "compaction": {
    "auto": true
  },
  "plugins": [
    "opencode-visual-cache@latest"
  ]
}
